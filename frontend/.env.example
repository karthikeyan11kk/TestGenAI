# ── Frontend environment variables ───────────────────────────────────────────

# When running locally (backend on same machine) — leave blank, Vite proxy handles it
VITE_API_URL=

# When backend is hosted on Render.com — paste your Render URL here
# VITE_API_URL=https://testgen-ai-backend.onrender.com

# When backend is on another PC on same network
# VITE_API_URL=http://192.168.1.50:8000
